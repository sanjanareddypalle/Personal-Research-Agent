# ==============================================================================
# ResearchFlow AI - Environment Configuration
# ==============================================================================

# LLM Configuration
# Options: "gemini", "openai", "demo"
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gemini-2.5-flash

# Search Engine Configuration
# Options: "duckduckgo" (free/default), "tavily", "demo"
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=your_tavily_api_key_here

# Embeddings & RAG Configuration
# Options: "local" (fast normalized vector hashing), "gemini", "openai"
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/researchflow.db
SYNC_DATABASE_URL=sqlite:///./data/researchflow.db

# Frontend URL for CORS
FRONTEND_ORIGIN=http://localhost:3005

# Force Demo Mode (if true, will never call live LLMs)
DEMO_MODE=false
